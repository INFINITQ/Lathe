{
  "name": "lathe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lathe: a fast, minimal code editor for Windows 11",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @lathe/app tauri dev",
    "build": "pnpm --filter @lathe/app tauri build",
    "build:e2e": "cargo build -p lathe-testkit --bins && pnpm --filter @lathe/app tauri build --debug --no-bundle",
    "build:perf": "node tools/build-perf.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "verify": "node tools/verify.mjs",
    "licenses:report": "node tools/license-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
